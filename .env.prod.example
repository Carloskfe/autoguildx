# Production environment variables
# Copy to .env.prod, fill in real values, then run:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Infrastructure ──────────────────────────────────────────────────────────
DOMAIN_NAME=autoguildx.com
POSTGRES_PASSWORD=change_me_to_a_strong_random_password
EMAIL=admin@autoguildx.com          # used by Let's Encrypt for cert expiry notices
